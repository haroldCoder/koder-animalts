generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  name          String?
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      Account[]
  owner         Owner?
  sessions      Session[]
  veterinarian  Veterinarian?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model VeterinaryClinic {
  id            String         @id @default(uuid())
  name          String
  address       String
  phone         String?
  email         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  documents     Document[]
  pets          Pet[]
  veterinarians Veterinarian[]
}

model Owner {
  id      String @id @default(uuid())
  phone   String
  address String
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id])
  pets    Pet[]
}

model Pet {
  id             String           @id @default(uuid())
  name           String
  species        String
  breed          String?
  birthDate      DateTime?
  gender         String?
  weight         Float?
  color          String?
  microchip      String?          @unique
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  ownerId        String
  clinicId       String
  iaImage        String?
  images         String[]         @default([])
  mainImage      String
  appointments   Appointment[]
  documents      Document[]
  medicalRecords MedicalRecord[]
  clinic         VeterinaryClinic @relation(fields: [clinicId], references: [id])
  owner          Owner            @relation(fields: [ownerId], references: [id])
}

model Veterinarian {
  id             String           @id @default(uuid())
  specialty      String?
  phone          String
  userId         String           @unique
  clinicId       String
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  vaccinations   Vaccination[]
  clinic         VeterinaryClinic @relation(fields: [clinicId], references: [id])
  user           User             @relation(fields: [userId], references: [id])
}

model MedicalRecord {
  id             String            @id @default(uuid())
  visitDate      DateTime          @default(now())
  reasonForVisit String
  diagnosis      String?
  treatment      String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  petId          String
  veterinarianId String
  type           MedicalRecordType @default(CONSULTATION)
  documents      Document[]
  pet            Pet               @relation(fields: [petId], references: [id])
  veterinarian   Veterinarian      @relation(fields: [veterinarianId], references: [id])
  vaccinations   Vaccination[]
}

model Vaccination {
  id               String        @id @default(uuid())
  vaccineName      String
  dateAdministered DateTime      @default(now())
  nextDueDate      DateTime?
  lotNumber        String?
  createdAt        DateTime      @default(now())
  status           VaccinationStatus @default(PENDING)
  medicalRecordId  String
  veterinarianId   String
  medicalRecord    MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  veterinarian     Veterinarian  @relation(fields: [veterinarianId], references: [id])
}

model Appointment {
  id             String       @id @default(uuid())
  date           DateTime
  reason         String
  status         String       @default("SCHEDULED")
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  petId          String
  veterinarianId String
  pet            Pet          @relation(fields: [petId], references: [id])
  veterinarian   Veterinarian @relation(fields: [veterinarianId], references: [id])
}

model Document {
  id              String            @id @default(uuid())
  title           String
  fileUrl         String
  fileKey         String?
  fileSize        Int?
  fileType        String?
  category        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  petId           String?
  medicalRecordId String?
  clinicId        String?
  clinic          VeterinaryClinic? @relation(fields: [clinicId], references: [id])
  medicalRecord   MedicalRecord?    @relation(fields: [medicalRecordId], references: [id])
  pet             Pet?              @relation(fields: [petId], references: [id])
}

enum MedicalRecordType {
  CONSULTATION
  VACCINATION
  SURGERY
  EMERGENCY
  LAB_RESULTS
  HOSPITALIZATION
}

enum VaccinationStatus {
  PENDING
  CANCELLED
  DONE
}